NODE_ENV=development

POSTGRES_DB=dev_market_oracle
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dev_market_oracle?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

API_PORT=3000
WEB_PORT=5173
CORS_ORIGIN=http://localhost:5173

# Docker Compose --profile full (does not reuse WEB_PORT/API_PORT from local .env)
# UI: http://localhost:8080  API: http://localhost:3000
# DOCKER_WEB_PORT=8080
# DOCKER_API_PORT=3000
# RUN_SEED=true

# HH public vacancy search is closed (403 since Apr 2026) — kept only as historical notes.
# Active MVP sources:
REMOTEOK_BASE_URL=https://remoteok.com
REMOTEOK_REQUEST_TIMEOUT_MS=15000
REMOTEOK_MAX_CONCURRENCY=1
REMOTEOK_DETAILS_LIMIT_PER_RUN=200
REMOTEOK_REFRESH_AFTER_HOURS=24

JOBICY_BASE_URL=https://jobicy.com
JOBICY_REQUEST_TIMEOUT_MS=15000
JOBICY_MAX_CONCURRENCY=1
JOBICY_DETAILS_LIMIT_PER_RUN=200
JOBICY_REFRESH_AFTER_HOURS=24

SYNC_MIN_HISTORY_DAYS_FOR_FORECAST=14
SYNC_FORECAST_HORIZON_DAYS=30
SYNC_DEFAULT_SOURCE_CODES=REMOTEOK,JOBICY
SYNC_MAX_PROFILES_PER_RUN=24
